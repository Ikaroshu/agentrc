prefix_rule(
    pattern = ["agentrc-codex-doc-review", ["high", "max"]],
    decision = "allow",
    justification = "User explicitly authorizes the managed read-only Codex document-review runner",
    match = [
        "agentrc-codex-doc-review high /skills/doc/SKILL.md review",
        "agentrc-codex-doc-review max /skills/doc/SKILL.md review",
    ],
    not_match = [
        "agentrc-codex-doc-review medium /skills/doc/SKILL.md review",
        "agentrc-codex-code-review high /skills/code/SKILL.md review",
    ],
)

prefix_rule(
    pattern = ["agentrc-codex-code-review", ["high", "max"]],
    decision = "allow",
    justification = "User explicitly authorizes the managed read-only Codex code-review runner with the Python environment isolated",
    match = [
        "agentrc-codex-code-review high /skills/code/SKILL.md review",
        "agentrc-codex-code-review max /skills/code/SKILL.md review",
    ],
    not_match = [
        "agentrc-codex-code-review medium /skills/code/SKILL.md review",
        "agentrc-codex-doc-review high /skills/doc/SKILL.md review",
    ],
)
